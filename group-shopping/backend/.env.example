# ── DealDesi Group Shopping — Backend Environment ──────────────
# Copy this file to .env and fill in your values

PORT=4000

# Frontend origin for CORS — your Render frontend URL
# e.g. https://dealdesi-group-shopping.onrender.com
FRONTEND_URL=http://localhost:5173

# Optional: log level (info | debug | warn | error)
LOG_LEVEL=info
